{
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/superapi", "destination": "/superapi.html" },
    { "source": "/profile", "destination": "/superapi.html" },
    { "source": "/recharge", "destination": "/superapi.html" },
    { "source": "/login", "destination": "/superapi.html" },
    { "source": "/chat", "destination": "/superapi.html" },
    { "source": "/models", "destination": "/superapi.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
