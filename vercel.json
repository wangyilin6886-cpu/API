{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ecoapi\\.ai" }],
      "destination": "/ecoapi",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www\\.ecoapi\\.ai" }],
      "destination": "/ecoapi",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/deepseek/:path*", "destination": "https://api.deepseek.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
