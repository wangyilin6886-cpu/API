# Copy to .env.local for local development (never commit .env.local)

# Neon Postgres — get from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT signing secret — any long random string. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Supplier A (agent-on) upstream key — serves both Claude (/api/v1/messages)
# and GPT (/api/responses); the proxy swaps user ek- keys for this
SUPPLIER_A_KEY=cap_client_xxx

# Supplier B (rezeai) upstream key — serves Gemini (/api/v1/chat/completions)
SUPPLIER_B_KEY=sk-xxx

# Polar (card payments) — from polar.sh dashboard
POLAR_ACCESS_TOKEN=polar_oat_xxx
POLAR_WEBHOOK_SECRET=whsec_xxx
# Optional: use https://sandbox-api.polar.sh for testing
POLAR_API_BASE=https://api.polar.sh

# DeepSeek (frontend chat widget)
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key
